{
  "openapi": "3.0.3",
  "info": {
    "title": "Todo API",
    "version": "1.0.0",
    "description": "Express and PostgreSQL todo API with JWT login. Every route except /health, /register and /login needs the token from /login in the Authorization header (a Bearer prefix is accepted). Errors are JSON: {\"error\": \"message\"}."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Todos"
    },
    {
      "name": "Data"
    },
    {
      "name": "Ops"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "example": "Todo not found"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "/register requires at least 8 characters; /login accepts 1 to 72."
          }
        }
      },
      "TodoInput": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"],
            "default": "Low"
          },
          "category": {
            "type": "string",
            "maxLength": 50,
            "nullable": true
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "recurrence": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly", "none"],
            "nullable": true,
            "description": "A repeating todo needs a due date."
          }
        }
      },
      "Todo": {
        "type": "object",
        "properties": {
          "todo_id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "completed": {
            "type": "boolean"
          },
          "recurrence": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly"],
            "nullable": true
          },
          "parent_id": {
            "type": "integer",
            "nullable": true,
            "description": "Null for a todo; set for a subtask."
          },
          "position": {
            "type": "integer",
            "description": "Place in the user's own order."
          },
          "subtasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subtask"
            },
            "description": "Only in the list: the todo's subtasks in order."
          },
          "progress": {
            "type": "object",
            "description": "Only in the list: subtasks done over subtasks in total.",
            "properties": {
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ExportedTodo": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "completed": {
            "type": "boolean"
          },
          "recurrence": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly"],
            "nullable": true
          }
        }
      },
      "ReminderItem": {
        "type": "object",
        "properties": {
          "todo_id": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "recurrence": {
            "type": "string",
            "nullable": true
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Subtask": {
        "type": "object",
        "properties": {
          "todo_id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "parent_id": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "position": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Todo not found, or not yours",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit reached",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "TodoId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Today": {
        "name": "today",
        "in": "query",
        "required": true,
        "description": "The caller's local date; must be within two days of the server's.",
        "schema": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Ops"],
        "summary": "Database check",
        "responses": {
          "200": {
            "description": "Database reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create an account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "integer"
                    },
                    "username": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Username already taken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange credentials for a token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Invalid username or password"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/todos": {
      "get": {
        "tags": ["Todos"],
        "summary": "Your todos in your own order, each with its subtasks and their progress",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "List",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["Todos"],
        "summary": "Create a todo",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/todos/parse": {
      "post": {
        "tags": ["Todos"],
        "summary": "Sentence to todo fields",
        "description": "Fills the form only; nothing is saved. Limited to 20 requests a minute per user.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text", "today"],
                "properties": {
                  "text": {
                    "type": "string",
                    "example": "pay rent next friday, high priority"
                  },
                  "today": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "due_date": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "priority": {
                      "type": "string",
                      "enum": ["Low", "Medium", "High"]
                    },
                    "category": {
                      "type": "string",
                      "nullable": true
                    },
                    "source": {
                      "type": "string",
                      "enum": ["model", "rules"]
                    },
                    "limited": {
                      "type": "boolean",
                      "description": "True when the model quota is used up and the rules answered."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/todos/reminders": {
      "get": {
        "tags": ["Todos"],
        "summary": "Open todos that are overdue, due today or due tomorrow",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Today"
          }
        ],
        "responses": {
          "200": {
            "description": "Grouped by the caller's date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "overdue": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReminderItem"
                      }
                    },
                    "today": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReminderItem"
                      }
                    },
                    "tomorrow": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReminderItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/todos/{id}": {
      "put": {
        "tags": ["Todos"],
        "summary": "Replace the editable fields of one of your todos",
        "description": "Ticking a repeating todo done also creates the next one and returns it as `next`.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TodoId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Todo"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "next": {
                          "$ref": "#/components/schemas/Todo"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Todos"],
        "summary": "Delete one of your todos or subtasks",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TodoId"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Deleting a todo deletes its subtasks in the same statement."
      }
    },
    "/export": {
      "get": {
        "tags": ["Data"],
        "summary": "Your todos without ids",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "List",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExportedTodo"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "description": "Top-level todos only; subtasks are not exported."
      }
    },
    "/import": {
      "post": {
        "tags": ["Data"],
        "summary": "Import 1 to 500 todos, all or nothing",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["todos"],
                "properties": {
                  "todos": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/TodoInput"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "imported": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/todos/order": {
      "put": {
        "tags": ["Todos"],
        "summary": "Set the order of some of your todos, or of the subtasks of one todo",
        "description": "The ids take, in the order sent, the positions they hold now, so todos left out keep theirs. With `parent_id` the ids must be subtasks of that todo; without it they must be top-level todos.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids"],
                "properties": {
                  "ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "integer"
                    }
                  },
                  "parent_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ordered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ordered": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/todos/{id}/subtasks": {
      "post": {
        "tags": ["Todos"],
        "summary": "Add a subtask to one of your todos",
        "description": "A subtask cannot have subtasks, and a todo has at most 50.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TodoId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": {
                    "type": "string",
                    "maxLength": 300
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subtask"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/subtasks/{id}": {
      "patch": {
        "tags": ["Todos"],
        "summary": "Rename a subtask or tick it done",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "completed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subtask"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  }
}
