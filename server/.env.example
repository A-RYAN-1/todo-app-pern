# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todos
# Set to true for hosted databases that require TLS (Neon, Supabase).
DATABASE_SSL=false
# Secret used to sign login tokens. Required, 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
# How long a login lasts (jsonwebtoken format).
JWT_EXPIRES_IN=7d
# Port the API listens on.
PORT=5000
# Origin of the React app allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# Optional: Gemini API key for the "Fill from a sentence" helper. Without it the
# helper uses the rule-based parser. Never commit a real key.
GEMINI_API_KEY=
# Model used by the helper (free tier).
GEMINI_MODEL=gemini-3.5-flash-lite
# Daily model-call caps; past them the helper falls back to the rules.
NL_DAILY_USER_LIMIT=30
NL_DAILY_TOTAL_LIMIT=300
